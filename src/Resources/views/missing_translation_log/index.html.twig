{% extends '@NowoTranslationYamlToolsBundle/missing_translation_log/base.html.twig' %}

{% block missing_log_title %}Missing translation log{% endblock %}

{% block missing_log_breadcrumb %}
    {# Pass {@code trail} from a controller / listener to render BreadcrumbKit; bundle optional. #}
    {% if trail is defined and trail is not null %}
        <div class="mb-1">
            {% include '@NowoBreadcrumbKitBundle/breadcrumb.html.twig' ignore missing %}
        </div>
    {% endif %}
    {% block missing_log_breadcrumb_extra %}{% endblock %}
{% endblock %}

{% block missing_log_body %}
    {% block missing_log_page_header %}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">Missing translation log</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                {# CSRF-only action forms (MissingTranslationLogActionType): hidden children via the child loop, button outside it. #}
                {{ form_start(clear_status_form, {attr: {class: 'd-inline', onsubmit: 'return confirm(\'Delete rows with status ' ~ status ~ '? This action cannot be undone.\');'}}) }}
                    {% for child in clear_status_form %}
                        {% if not child.rendered %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                    <button type="submit" class="btn btn-sm btn-outline-warning">Clear current status</button>
                {{ form_end(clear_status_form) }}
                {{ form_start(clear_form, {attr: {class: 'd-inline', onsubmit: 'return confirm(\'Delete all missing-log rows? This action cannot be undone.\');'}}) }}
                    {% for child in clear_form %}
                        {% if not child.rendered %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                    <button type="submit" class="btn btn-sm btn-outline-danger">Clear all rows</button>
                {{ form_end(clear_form) }}
            </div>
        </div>
    {% endblock %}
    {% block missing_log_status_filters %}
        {% include '@NowoTranslationYamlToolsBundle/missing_translation_log/_status_filters.html.twig' %}
    {% endblock %}
    {% block missing_log_table %}
        {% include '@NowoTranslationYamlToolsBundle/missing_translation_log/_table.html.twig' %}
    {% endblock %}
{% endblock %}
