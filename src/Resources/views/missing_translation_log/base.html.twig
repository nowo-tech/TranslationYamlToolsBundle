{% extends nowo_translation_yaml_tools_missing_log_layout_template|default('@NowoTranslationYamlToolsBundle/missing_translation_log/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{# REQ-UI-001 / REQ-UI-001-kit: stack host assets when layout_template points at the project / a bridge. #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block nowo_translation_yaml_tools_missing_log_content %}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">{{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    {% endfor %}

    {% block missing_log_breadcrumb %}{% endblock %}

    {% block missing_log_body %}{% endblock %}
{% endblock %}
