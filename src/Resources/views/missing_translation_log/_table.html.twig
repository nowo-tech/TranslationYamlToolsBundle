<div class="table-responsive">
    <table class="table table-sm table-bordered table-hover align-middle bg-white">
        <thead class="table-light">
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Locale</th>
            <th scope="col">Domain</th>
            <th scope="col">Message id</th>
            <th scope="col">Call site</th>
            <th scope="col">Route</th>
            <th scope="col">Method</th>
            <th scope="col">Path</th>
            <th scope="col">Hits</th>
            <th scope="col">Last seen</th>
            {% if status == 'pending' %}
                <th scope="col">Action</th>
            {% endif %}
        </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td>{{ row.id }}</td>
                <td>{{ row.locale }}</td>
                <td>{{ row.domain }}</td>
                <td><code class="small">{{ row.messageId }}</code></td>
                <td><small class="text-muted">{{ row.callSite ?? '—' }}</small></td>
                <td><small class="text-muted">{{ row.requestRoute ?? '—' }}</small></td>
                <td><small class="text-muted">{{ row.requestMethod ?? '—' }}</small></td>
                <td><small class="text-muted text-break">{{ row.requestPath ?? '—' }}</small></td>
                <td>{{ row.hitCount }}</td>
                <td><small>{{ row.lastSeenAt|date('c') }}</small></td>
                {% if status == 'pending' %}
                    <td>
                        {% set mark_added_form = mark_added_forms[row.id] %}
                        {{ form_start(mark_added_form, {attr: {class: 'd-inline'}}) }}
                            {% for child in mark_added_form %}
                                {% if not child.rendered %}
                                    {{ form_row(child) }}
                                {% endif %}
                            {% endfor %}
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark added</button>
                        {{ form_end(mark_added_form) }}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ status == 'pending' ? 11 : 10 }}" class="text-muted">No rows.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
