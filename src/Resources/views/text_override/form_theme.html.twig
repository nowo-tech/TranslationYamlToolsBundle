{# Form theme of the text-overrides desk (applied on top of bootstrap_5_layout by text_override/edit.html.twig).
   nowo_tyt_locale_tabs_*: the unmapped "_tab" radio group of TranslationOverrideTextsType rendered as CSS-only
   tabs: each radio is followed by its label, both direct children of the tabs fieldset, so the page CSS can show
   the matching panel with "#nowo-tyt-tab-N:checked ~ #nowo-tyt-panel-N" (no JavaScript).
   Variables: nowo_tyt_active (locale whose tab is checked), nowo_tyt_overridden (locales with an override). #}
{% block nowo_tyt_locale_tabs_row -%}
    {{- form_widget(form) -}}
{%- endblock nowo_tyt_locale_tabs_row %}

{% block nowo_tyt_locale_tabs_widget -%}
    {%- set active = nowo_tyt_active|default(value) -%}
    {%- for child in form -%}
        <input class="nowo-tyt-tab-input" type="radio" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}" id="nowo-tyt-tab-{{ loop.index }}"{% if child.vars.value == active %} checked{% endif %}>
        <label class="nowo-tyt-tab-label d-inline-block px-3 py-1 me-1" for="nowo-tyt-tab-{{ loop.index }}">{{ child.vars.label }}{% if child.vars.value in nowo_tyt_overridden|default([]) %} <span class="badge text-bg-info">{{ 'overrides.badge_overridden'|trans({}, 'NowoTranslationYamlToolsBundle') }}</span>{% endif %}</label>
        {%- do child.setRendered() -%}
    {%- endfor -%}
{%- endblock nowo_tyt_locale_tabs_widget %}
