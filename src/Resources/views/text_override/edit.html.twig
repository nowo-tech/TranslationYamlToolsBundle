{#
  Text-overrides desk, edit one text (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from
  TranslationOverridePageFactory::edit(): header overrides.edit_title / overrides.edit_intro with a back link to the
  texts of the same group; form = TranslationOverrideTextsType (one textarea per locale); submit overrides.save,
  cancel = the list; delete zone = Restore shipped text (POST + CSRF-only TranslationOverrideResetType FormView behind
  a Confirm) when a locale is overridden; formThemes = overrides.web_ui.form_themes).
  Extra variables: key (the edited reference), group, locales, default_locale, active_locale (first locale with an
  error, else the first one), texts, shipped (locale => shipped text), errors, max_length, overridden (locales with
  an override), form (the FormView of page.form), reset_form (the FormView of the reset action: render it only once).
  Data block filled: nowo_ui_form_body (the key, then one UiKit locale tab per textarea with the shipped text, then
  the REQ-TWIG-003 child loop for the remaining fields).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoTranslationYamlToolsBundle' %}

{% block nowo_ui_form_body %}
    {% set _b = page.bundle %}
    <p class="{{ nowo_ui_class('muted', _b) }}"><code class="{{ nowo_ui_class('code', _b) }}" data-testid="tyt-overrides-key">{{ key }}</code></p>
    {{ form_errors(form) }}
    {% set _panels = [] %}
    {% for locale in locales %}
        {% set _child = form[locale] %}
        {% set _content %}
            {% if locale in overridden %}
                <p><span class="{{ nowo_ui_class('badge_info', _b) }}" data-testid="tyt-overrides-overridden">{{ 'overrides.badge_overridden'|trans }}</span></p>
            {% endif %}
            {{ form_row(_child) }}
            <details class="nowo-tyt-shipped">
                <summary>{{ 'overrides.shipped'|trans }}</summary>
                <p class="{{ nowo_ui_class('muted', _b) }}">{{ shipped[locale] ?? '' }}</p>
            </details>
        {% endset %}
        {% set _panels = _panels|merge([{locale: locale, content: _content, invalid: _child.vars.errors|length > 0, attr: {'data-testid': 'tyt-overrides-panel-' ~ locale}}]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('locale_tabs', _b), {
        panels: _panels,
        id: 'nowo-tyt-texts',
        label: 'overrides.locale_tabs'|trans,
        default_locale: default_locale,
        active_locale: active_locale,
        bundle: _b,
        nowo_ui_page_type: nowo_ui_page_type,
    }, false) }}
    {% for child in form %}
        {% if not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
{% endblock %}
