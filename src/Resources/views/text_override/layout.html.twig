{# Default standalone shell for the translation-overrides desk (Bootstrap 5 from CDN, no inline JS).
   Point overrides.web_ui.layout_template at your admin layout instead: it must define blocks "title" and "body".
   Inline <style> in the pages carries the CSP nonce from the request attribute "csp_nonce" when present. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'overrides.title'|trans({}, 'NowoTranslationYamlToolsBundle') }}{% endblock %}</title>
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endblock %}
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('nowo_translation_yaml_tools_overrides_index') }}">{{ 'overrides.title'|trans({}, 'NowoTranslationYamlToolsBundle') }}</a>
        </div>
    </nav>
    <main class="container-fluid py-4">
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : 'success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
    {% block javascripts %}{% endblock %}
</body>
</html>
