{#
  Text-overrides desk, texts list (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  TranslationOverridePageFactory::index(): header overrides.title / overrides.intro; filters = the GET
  TranslationOverrideFilterType (q, group); columns key, text (default locale), overridden; rows = list of
  {key, text, overridden}; row action Edit; Pagination; EmptyState overrides.empty).
  Extra variables (1.x, kept for web_ui.templates overrides): filter_form (the FormView of page.filters: render it
  only once), rows, groups, group, query, default_locale, override_count.
  Data blocks filled: nowo_ui_list_row (cells), nowo_ui_content (the override count, then parent()).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoTranslationYamlToolsBundle' %}

{% block nowo_ui_content %}
    <p class="{{ nowo_ui_class('muted', page.bundle) }}" data-testid="tyt-overrides-count">{{ 'overrides.override_count'|trans({'%count%': override_count}) }}</p>
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'overrides.col.key'|trans }}" data-required="1"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.key }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'overrides.col.text'|trans({'%locale%': default_locale|upper}) }}">{{ row.text }}</td>
    <td class="{{ _cell }}{{ row.overridden is empty ? ' ' ~ nowo_ui_class('table_cell_muted', _b) }}" data-label="{{ 'overrides.col.overridden'|trans }}" data-nowo-ui-priority="2">
        {%- for locale in row.overridden -%}
            <span class="{{ nowo_ui_class('badge_info', _b) }}" data-testid="tyt-overrides-overridden">{{ locale|upper }}</span>{{ not loop.last ? ' ' }}
        {%- else -%}
            —
        {%- endfor -%}
    </td>
{% endblock %}
