# PHPUnit / test environment (versioned). Do not commit .env or .env.dev.

# APP_ENV: Symfony environment for automated tests.
APP_ENV=test

# APP_SECRET: fixed secret for deterministic tests.
APP_SECRET=test_secret_test_secret_test_secret

# APP_DEBUG: keep debug enabled for clearer test failures.
APP_DEBUG=1

# TRUSTED_PROXIES: trusted proxies in the test harness.
TRUSTED_PROXIES=127.0.0.1

# DEFAULT_URI: base URI used by the router in tests.
DEFAULT_URI=http://localhost

# GOOGLE_TRANSLATE_API_KEY: not required for unit/integration tests.
GOOGLE_TRANSLATE_API_KEY=

# DATABASE_URL: isolated SQLite database for tests.
DATABASE_URL=mysql://app:app@db:3306/app?serverVersion=8.4&charset=utf8mb4
