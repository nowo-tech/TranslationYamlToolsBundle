{#
  Demo host layout (REQ-UI-003 nowo_ui_kit.layouts.admin): the UiKit admin layout plus the demo masthead in
  nowo_ui_navigation and the host CSS stack (Bootstrap 5 + Bootstrap Icons, demo assets: the bundle ships no layout
  and no CDN link). The missing-translation log and the text-overrides desk (UiKit list / form scaffolds) render
  inside it.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_styles %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {{ parent() }}
    <style>
        body { margin: 0; background: #f8fafc; }
        .nowo-ui-content { padding: 1.25rem 1.5rem 2rem; }
        .demo-masthead { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; padding: .75rem 1.5rem; background: #0f172a; color: #e2e8f0; }
        .demo-masthead a { color: inherit; text-decoration: none; }
        .demo-masthead__brand { font-weight: 700; letter-spacing: .01em; }
        .demo-masthead__nav { display: flex; flex-wrap: wrap; gap: 1rem; font-size: .925rem; }
        .demo-masthead__nav a:hover, .demo-masthead__nav a[aria-current="page"] { color: #fff; text-decoration: underline; text-underline-offset: .25em; }
        .demo-masthead__note { margin-left: auto; font-size: .8rem; color: #94a3b8; }
    </style>
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="demo-masthead">
        <a class="demo-masthead__brand" href="{{ path('demo_home') }}">Translation YAML Tools demo</a>
        <nav class="demo-masthead__nav" aria-label="Demo">
            <a href="{{ path('demo_home') }}">Insights</a>
            <a href="{{ path('nowo_translation_yaml_tools_missing_log_index') }}"{% if _route starts with 'nowo_translation_yaml_tools_missing_log' %} aria-current="page"{% endif %}>Missing-log UI</a>
            <a href="{{ path('nowo_translation_yaml_tools_overrides_index') }}"{% if _route starts with 'nowo_translation_yaml_tools_overrides' %} aria-current="page"{% endif %}>Site texts</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
        <span class="demo-masthead__note">Symfony 8 · FrankenPHP · UiKit page contract</span>
    </header>
{% endblock %}
