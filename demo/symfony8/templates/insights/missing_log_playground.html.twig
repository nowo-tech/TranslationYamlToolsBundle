{#- REQ-DEMO-014: UiKit page in the demo shell (base.html.twig); no foreign CSS. -#}
{% extends 'base.html.twig' %}

{% block title %}Missing-log playground{% endblock %}

{% block body %}
{% include 'insights/_demo_menu.html.twig' %}
<div class="nowo-ui-page-header"><h1 class="nowo-ui-page-header__title">Missing-log playground ({{ demo_label }})</h1></div>
<p>Scenario: <strong>{{ scenario_title }}</strong>. These pages intentionally trigger missing translation keys.</p>
<section class="nowo-ui-card">
    <div class="nowo-ui-card__body">

{% if scenario == 'twig' %}
    <h2>Twig probes</h2>
    <ul>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.filter_simple'|trans({}, 'messages') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.filter_with_params'|trans({'%name%': 'Alice'}, 'messages') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.custom_domain'|trans({}, 'demo_runtime') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.forced_locale_fr'|trans({}, 'messages', 'fr') }}</code></li>
        <li>{% trans from 'messages' %}nowo_demo.probe_twig.trans_tag{% endtrans %}</li>
    </ul>
{% elseif scenario == 'domain-locale' %}
    <h2>Domain and locale probes</h2>
    <ul>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.messages'|trans({}, 'messages') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.custom_domain'|trans({}, 'demo_runtime') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.forced_es'|trans({}, 'messages', 'es') }}</code></li>
        <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.forced_fr'|trans({}, 'messages', 'fr') }}</code></li>
    </ul>
    <p>Controller also triggers misses in this scenario (messages/custom domain/forced locale) to compare Twig vs PHP call sites.</p>
{% else %}
    <h2>Repeat-hits probes</h2>
    {% for i in 1..5 %}
        {{ 'nowo_demo.probe_repeat.twig_key'|trans({}, 'messages') }}
    {% endfor %}
    {% for i in 1..3 %}
        {{ 'nowo_demo.probe_repeat.twig_custom_domain'|trans({}, 'demo_runtime') }}
    {% endfor %}
    <p>Reload this page a few times and check how <code class="nowo-ui-code">hit_count</code> increases for the same key/domain/locale.</p>
{% endif %}

<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_translation_yaml_tools_missing_log_index') }}">Open missing-log UI</a>
    </div>
</section>
{% endblock %}
