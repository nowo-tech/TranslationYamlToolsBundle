{#- REQ-DEMO-014: UiKit page in the demo platform shell (base.html.twig); no foreign CSS. -#}
{% extends 'base.html.twig' %}

{% block title %}Missing-log playground{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_translation_yaml_tools_missing_log_index') }}">Open missing-log UI</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Missing-log playground (' ~ demo_label ~ ')',
        intro: 'Scenario: ' ~ scenario_title ~ '. These pages intentionally trigger missing translation keys.',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% if scenario == 'twig' %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Twig probes', kind: 'list'} %}
            {% block section_body %}
                <ul>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.filter_simple'|trans({}, 'messages') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.filter_with_params'|trans({'%name%': 'Alice'}, 'messages') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.custom_domain'|trans({}, 'demo_runtime') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_twig.forced_locale_fr'|trans({}, 'messages', 'fr') }}</code></li>
                    <li>{% trans from 'messages' %}nowo_demo.probe_twig.trans_tag{% endtrans %}</li>
                </ul>
            {% endblock %}
        {% endembed %}
    {% elseif scenario == 'domain-locale' %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Domain and locale probes', intro: 'The controller also triggers misses in this scenario (messages / custom domain / forced locale) to compare Twig vs PHP call sites.', kind: 'list'} %}
            {% block section_body %}
                <ul>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.messages'|trans({}, 'messages') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.custom_domain'|trans({}, 'demo_runtime') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.forced_es'|trans({}, 'messages', 'es') }}</code></li>
                    <li><code class="nowo-ui-code">{{ 'nowo_demo.probe_domain_locale.twig.forced_fr'|trans({}, 'messages', 'fr') }}</code></li>
                </ul>
            {% endblock %}
        {% endembed %}
    {% else %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Repeat-hits probes', intro: 'Reload this page a few times and check how hit_count increases for the same key/domain/locale.', kind: 'list'} %}
            {% block section_body %}
                {% for i in 1..5 %}
                    {{ 'nowo_demo.probe_repeat.twig_key'|trans({}, 'messages') }}
                {% endfor %}
                {% for i in 1..3 %}
                    {{ 'nowo_demo.probe_repeat.twig_custom_domain'|trans({}, 'demo_runtime') }}
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
