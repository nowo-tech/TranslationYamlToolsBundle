{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentScenario = app.request.attributes.get('scenario') %}
<nav class="demo-menu" aria-label="Demo navigation">
    <strong class="demo-menu-title">Demo menu</strong>
    <a class="demo-menu-link {{ currentRoute == 'demo_home' ? 'is-active' : '' }}" href="{{ path('demo_home') }}">Home</a>
    <a class="demo-menu-link {{ currentRoute == 'demo_missing_log_probes' and currentScenario == 'twig' ? 'is-active' : '' }}" href="{{ path('demo_missing_log_probes', { scenario: 'twig' }) }}">Twig probes</a>
    <a class="demo-menu-link {{ currentRoute == 'demo_missing_log_probes' and currentScenario == 'domain-locale' ? 'is-active' : '' }}" href="{{ path('demo_missing_log_probes', { scenario: 'domain-locale' }) }}">Domain/locale probes</a>
    <a class="demo-menu-link {{ currentRoute == 'demo_missing_log_probes' and currentScenario == 'repeat-hits' ? 'is-active' : '' }}" href="{{ path('demo_missing_log_probes', { scenario: 'repeat-hits' }) }}">Repeat-hits probes</a>
    {% if is_granted('ROLE_ADMIN') %}
        <a class="demo-menu-link" href="{{ path('nowo_translation_yaml_tools_missing_log_index') }}">Missing-log UI</a>
        <a class="demo-menu-link" href="{{ path('app_logout') }}">Logout</a>
    {% else %}
        <a class="demo-menu-link {{ currentRoute == 'app_login' ? 'is-active' : '' }}" href="{{ path('app_login') }}">Login (Missing-log UI)</a>
    {% endif %}
</nav>
