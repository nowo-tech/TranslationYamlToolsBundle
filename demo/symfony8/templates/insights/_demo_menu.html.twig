    <a class="nowo-ui-link" href="{{ path('demo_missing_log_probes', { scenario: 'domain-locale' }) }}"{% if currentRoute == 'demo_missing_log_probes' and currentScenario == 'domain-locale' %} aria-current="page"{% endif %}>Domain/locale probes</a>
    <a class="nowo-ui-link" href="{{ path('demo_missing_log_probes', { scenario: 'repeat-hits' }) }}"{% if currentRoute == 'demo_missing_log_probes' and currentScenario == 'repeat-hits' %} aria-current="page"{% endif %}>Repeat-hits probes</a>
