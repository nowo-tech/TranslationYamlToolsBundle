{#- REQ-DEMO-014: UiKit page in the demo shell (base.html.twig); no foreign CSS. -#}
{% extends 'base.html.twig' %}

{% block title %}Translation YAML Tools — insights{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Translation YAML Tools — demo (' ~ demo_label ~ ')',
        intro: 'Validates the default locale, enabled locales, YAML locations (including an extra translations_extra/ path) and missing files / keys per domain versus the default locale.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Symfony / Translator', kind: 'list', report: report} %}
        {% block section_body %}
            <ul>
                <li><strong>translator.default_locale</strong>: <code class="nowo-ui-code">{{ report.defaultLocale }}</code></li>
                <li><strong>kernel.enabled_locales</strong>: {% for loc in report.enabledLocales %}<code class="nowo-ui-code">{{ loc }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</li>
                <li><strong>translator.fallback_locales</strong>: {% if report.fallbackLocales|length %}{% for loc in report.fallbackLocales %}<code class="nowo-ui-code">{{ loc }}</code>{% if not loop.last %}, {% endif %}{% endfor %}{% else %}<em>(none)</em>{% endif %}</li>
                <li><strong>Bundle <code class="nowo-ui-code">TranslationDefaultLocaleResolver</code></strong> (respects <code class="nowo-ui-code">nowo_translation_yaml_tools.default_locale</code> when set): <code class="nowo-ui-code">{{ report.bundleResolvedDefaultLocale }}</code></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Resolved translation directories', intro: 'Same resolution as the bundle commands (translator.default_path + framework.translator.paths from YAML).', kind: 'list', report: report} %}
        {% block section_body %}
            <ul>
                {% for dir in report.directories %}
                    <li><code class="nowo-ui-code">{{ dir }}</code></li>
                {% endfor %}
            </ul>
            <p><em>Hints:</em></p>
            <ul>
                {% for line in report.directorySourcesHelp %}
                    <li>{{ line }}</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}

    {% for domain in report.domains %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Domain ' ~ domain.name, intro: 'YAML files per locale' ~ (domain.missingKeysVsDefault|length ? ' and the keys missing versus the default locale (' ~ report.defaultLocale ~ ')' : ''), kind: 'table', domain: domain, report: report} %}
            {% block section_body %}
                <table class="nowo-ui-data-table">
                    <thead>
                    <tr>
                        <th>Locale</th>
                        <th>YAML file</th>
                        <th>Enabled locale missing file?</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for loc, path in domain.files %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ loc }}</code></td>
                            <td>{% if path %}<code class="nowo-ui-code">{{ path }}</code>{% else %}—{% endif %}</td>
                            <td>—</td>
                        </tr>
                    {% endfor %}
                    {% for loc in domain.missingFilesForEnabledLocales %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ loc }}</code></td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--danger">—</span></td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--danger">Yes (expected in this demo for some locales)</span></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% if domain.missingKeysVsDefault|length %}
                    <table class="nowo-ui-data-table">
                        <thead>
                        <tr><th>Locale</th><th>Missing keys</th></tr>
                        </thead>
                        <tbody>
                        {% for loc, keys in domain.missingKeysVsDefault %}
                            <tr>
                                <td><code class="nowo-ui-code">{{ loc }}</code></td>
                                <td class="nowo-ui-cell--wrap"><ul>{% for k in keys %}<li><code class="nowo-ui-code">{{ k }}</code></li>{% endfor %}</ul></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            {% endblock %}
            {% block section_footer %}
                {% if domain.missingKeysVsDefault|length == 0 %}
                    <span class="nowo-ui-badge nowo-ui-badge--success">OK</span> No key gaps vs default for loaded locale files in this domain.
                {% endif %}
            {% endblock %}
        {% endembed %}
    {% endfor %}

    {% if app.environment == 'dev' %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Missing translation log (dev)', intro: 'Runtime missing keys are recorded in SQLite (demo_translation_missing_log) with async_persist + event_dispatcher (no Messenger).', kind: 'list'} %}
            {% block section_actions %}<a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('nowo_translation_yaml_tools_missing_log_index') }}">Missing-log Web UI</a>{% endblock %}
            {% block section_body %}
                <p>After loading this page, open the UI (<code class="nowo-ui-code">/_demo/translation-yaml-tools/missing-log</code>) or run <code class="nowo-ui-code">nowo:translation-yaml:missing-log-list</code>.</p>
                <p><strong>Probes</strong> (ids intentionally absent from YAML — inspect the Web UI or SQLite: <code class="nowo-ui-code">call_site</code> is the backtrace <strong>file:line</strong> only; <code class="nowo-ui-code">request_route</code>, <code class="nowo-ui-code">request_method</code>, and <code class="nowo-ui-code">request_path</code> hold the HTTP context when <code class="nowo-ui-code">record_request_context</code> is on, which it is by default in this demo):</p>
                <ul>
                    <li><strong>Twig <code class="nowo-ui-code">|trans</code> (this template):</strong> <code class="nowo-ui-code">{{ 'nowo_demo.missing_log_probe'|trans({}, 'messages') }}</code> — often <code class="nowo-ui-code">call_site</code> is under <code class="nowo-ui-code">var/cache/.../twig/*.php</code>, not this <code class="nowo-ui-code">.twig</code> line.</li>
                    <li><strong>Twig <code class="nowo-ui-code">|trans</code> (second key):</strong> <code class="nowo-ui-code">{{ 'nowo_demo.missing_from_twig_filter'|trans({}, 'messages') }}</code></li>
                    <li><strong>Twig <code class="nowo-ui-code">|trans</code> with parameters:</strong> <code class="nowo-ui-code">{{ 'nowo_demo.missing_from_twig_with_params'|trans({'%count%': 3}, 'messages') }}</code></li>
                    <li><strong>Twig <code class="nowo-ui-code">|trans</code> in custom domain:</strong> <code class="nowo-ui-code">{{ 'nowo_demo.missing_from_twig_custom_domain'|trans({}, 'demo_runtime') }}</code></li>
                    <li><strong>Twig <code class="nowo-ui-code">|trans</code> with forced locale <code class="nowo-ui-code">fr</code>:</strong> <code class="nowo-ui-code">{{ 'nowo_demo.missing_from_twig_forced_locale'|trans({}, 'messages', 'fr') }}</code></li>
                    <li><strong>Twig <code class="nowo-ui-code">{% verbatim %}{% trans %}{% endverbatim %}</code> tag:</strong> {% trans from 'messages' %}nowo_demo.missing_from_twig_tag{% endtrans %}</li>
                    <li><strong>PHP controller</strong> (same request, before render): <code class="nowo-ui-code">nowo_demo.missing_from_controller</code> — <code class="nowo-ui-code">call_site</code> should point at <code class="nowo-ui-code">TranslationInsightsController.php</code>; the request columns should match this page's route and path.</li>
                    <li><strong>PHP controller</strong> with params: <code class="nowo-ui-code">nowo_demo.missing_from_controller_with_params</code> (domain <code class="nowo-ui-code">messages</code>)</li>
                    <li><strong>PHP controller</strong> custom domain: <code class="nowo-ui-code">nowo_demo.missing_in_custom_domain</code> (domain <code class="nowo-ui-code">demo_runtime</code>)</li>
                    <li><strong>PHP controller</strong> forced locale: <code class="nowo-ui-code">nowo_demo.missing_forced_locale</code> (locale <code class="nowo-ui-code">fr</code>)</li>
                </ul>
                <p>See <a href="https://github.com/nowo-tech/TranslationYamlToolsBundle/blob/main/docs/USAGE.md#missing-translation-log-coverage-and-call_site">docs/USAGE.md — coverage and call_site</a> for what the log can and cannot capture.</p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Inline translations (Twig)', kind: 'content'} %}
        {% block section_body %}
            <p>{{ 'demo.inline_banner'|trans({'%product%': 'Translation YAML Tools'}) }}</p>
            <p><em>{% trans %}Hello, demo visitor{% endtrans %}</em> — second line uses the <code class="nowo-ui-code">{% verbatim %}{% trans %}{% endverbatim %}</code> tag (message id = English source string; Spanish lives in <code class="nowo-ui-code">messages.es.yaml</code>).</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'CLI (inside the container)', intro: 'From the demo directory, make translation-yaml-demos runs the bundle commands in dry-run mode; make translation-yaml-inline-preview briefly rewrites messages.en.yaml with --inline (flow YAML) and restores it.', kind: 'content'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" tabindex="0"><code>php bin/console nowo:translation-yaml:tree --dry-run --domain=messages --locale=en
php bin/console nowo:translation-yaml:sort --dry-run --domain=messages --locale=en
php bin/console nowo:translation-yaml:sort --inline --domain=messages --locale=en
php bin/console nowo:translation-yaml:fill-missing --dry-run --domain=messages --target-locale=es</code></pre>
        {% endblock %}
    {% endembed %}
{% endblock %}
