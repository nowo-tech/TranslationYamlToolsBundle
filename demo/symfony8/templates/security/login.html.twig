{% extends 'base.html.twig' %}

{% block title %}Login — Translation YAML Tools demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Demo login',
        intro: 'Required for the missing-log Web UI (ROLE_ADMIN). Credentials: admin / admin (local demos only).',
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: error ? {error: [error.messageKey|trans(error.messageData, 'security')]} : null}) }}
{% endblock %}

{% block body %}
    {#- REQ-TWIG-005 rule 8: LoginFormType maps _username / _password / _csrf_token (authenticate). -#}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sign in', kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-login-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_home') }}">Back to home</a>
            <button type="submit" form="demo-login-form" class="nowo-ui-btn nowo-ui-btn--primary">Sign in</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
